// TSConfig for monorepo root, targeting the browser. Packages have their own tsconfig.json files that extend this one.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@williamthorsen/tsconfig/tsconfig.base.json",
  "compilerOptions": {
    // The scaffold's identity test imports its package.json.
    "resolveJsonModule": true,
    // Every package here runs in the browser. `lib` replaces the base's list, so its ES libs are repeated.
    "lib": ["DOM", "DOM.Iterable", "ES2025", "ESNext.Disposable", "ESNext.Array"],
    "jsx": "react-jsx",
    // The base enables this for packages that emit with `tsc`, which rejects a `.ts` extension on a non-relative
    // specifier such as `#src/…`. No package here emits with `tsc`, and `nmr-compile` enables it for its own emit.
    "rewriteRelativeImportExtensions": false,
  },
  "include": [
    ".config/**/*.ts",
    ".readyup/**/*.ts",
    "__tests__/",
    "scripts/",
    // Root-level config files (vite/vitest); the project service resolves each linted `.ts` file's owning config here.
    "*.ts",
  ],
}
