{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // The package runs in a browser and in Node, so its source may use neither environment's APIs. `lib` replaces the
    // root's list, so its ES entries are repeated without the DOM ones.
    "lib": ["ES2025", "ESNext.Disposable", "ESNext.Array"],
    "paths": {
      "#src/*": ["./src/*"],
    },
    "types": [],
  },
  "include": ["src/", "*.ts"],
}
